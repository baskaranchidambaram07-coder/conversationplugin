{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v python >/dev/null 2>&1 && PY=python || PY=python3; \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/scan-before-push.py\"",
            "timeout": 60,
            "statusMessage": "Checking for a push to scan"
          }
        ]
      }
    ]
  }
}
