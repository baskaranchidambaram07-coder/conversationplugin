{
  "name": "conversationplugin",
  "private": true,
  "workspaces": [
    "protocol",
    "web/loader",
    "web/widget",
    "e2e"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run e2e --workspace @ucp/e2e",
    "e2e:gateway": "npm run e2e:gateway --workspace @ucp/e2e"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
