{
  "openapi": "3.1.0",
  "info": {
    "title": "Conversation Gateway",
    "version": "1"
  },
  "paths": {
    "/v1/widgets/{widget_id}/config": {
      "get": {
        "summary": "A widget's display settings, read by the loader on the customer's page",
        "operationId": "config_v1_widgets__widget_id__config_get",
        "parameters": [
          {
            "name": "widget_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Our opaque ID. Never a PF ID.",
              "title": "Widget Id"
            },
            "description": "Our opaque ID. Never a PF ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetConfig"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "summary": "Start a session for a visitor of a widget",
        "operationId": "start_session_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "4XX": {
            "description": "Client Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/conversations": {
      "post": {
        "summary": "Start a conversation",
        "operationId": "create_conversation_v1_conversations_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Client Error"
          }
        }
      },
      "get": {
        "summary": "The visitor's conversations, most recently active first",
        "operationId": "list_conversations_v1_conversations_get",
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Cursor"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationPage"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Client Error"
          }
        }
      }
    },
    "/v1/conversations/{conversation_id}/messages": {
      "get": {
        "summary": "A page of a conversation, oldest first",
        "operationId": "read_messages_v1_conversations__conversation_id__messages_get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Our opaque ID. Never a PF ID.",
              "title": "Conversation Id"
            },
            "description": "Our opaque ID. Never a PF ID."
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{1,9}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagePage"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Client Error"
          }
        }
      },
      "post": {
        "summary": "Ask a question. The answer streams as StreamEvent lines, or arrives whole as a Message for `Accept: application/json`.",
        "operationId": "send_message_v1_conversations__conversation_id__messages_post",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Our opaque ID. Never a PF ID.",
              "title": "Conversation Id"
            },
            "description": "Our opaque ID. Never a PF ID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessage"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              },
              "text/event-stream": {}
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Client Error"
          }
        }
      }
    },
    "/v1/conversations/{conversation_id}/messages/{message_id}": {
      "get": {
        "summary": "One message, as stored now",
        "operationId": "read_message_v1_conversations__conversation_id__messages__message_id__get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Our opaque ID. Never a PF ID.",
              "title": "Conversation Id"
            },
            "description": "Our opaque ID. Never a PF ID."
          },
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Our opaque ID. Never a PF ID.",
              "title": "Message Id"
            },
            "description": "Our opaque ID. Never a PF ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Client Error"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "The process is up. The load balancer restarts a task that stops answering.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readyz",
        "description": "The gateway can serve: its database answers.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readyz Readyz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "session_expired",
              "forbidden",
              "site_not_allowed",
              "not_found",
              "turn_in_progress",
              "rate_limited",
              "assistant_unavailable",
              "internal_error"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Our own wording. Never text from PF."
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "retry_after": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After",
            "description": "Seconds to wait before retrying."
          },
          "reference": {
            "$ref": "#/components/schemas/Id",
            "description": "The correlation ID, shown to the user so support can find the request."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "retry_after",
          "reference"
        ],
        "title": "ApiError",
        "description": "The body of every error response, and the payload of `message.failed`."
      },
      "Block": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextBlock"
          },
          {
            "$ref": "#/components/schemas/MarkdownBlock"
          },
          {
            "$ref": "#/components/schemas/UnknownBlock"
          }
        ]
      },
      "Conversation": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "Conversation"
      },
      "ConversationPage": {
        "properties": {
          "conversations": {
            "items": {
              "$ref": "#/components/schemas/Conversation"
            },
            "type": "array",
            "title": "Conversations"
          },
          "next": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Cursor"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when there are no older conversations."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversations",
          "next"
        ],
        "title": "ConversationPage",
        "description": "Reply to GET /v1/conversations: the visitor's conversations, most recently active first."
      },
      "Cursor": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:+-]{1,64}$",
        "description": "Opaque. Pass it as `before` for the next page."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "description": "Our opaque ID. Never a PF ID."
      },
      "MarkdownBlock": {
        "properties": {
          "type": {
            "type": "string",
            "const": "markdown",
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "title": "MarkdownBlock",
        "description": "Markdown. Tables, code and fenced diagram blocks travel inside it (D9)."
      },
      "Message": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "complete",
              "failed",
              "stopped"
            ],
            "title": "Status"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "type": "array",
            "title": "Blocks"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApiError"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "role",
          "status",
          "blocks",
          "error",
          "created_at"
        ],
        "title": "Message"
      },
      "MessagePage": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Messages"
          },
          "next": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Cursor"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when this page starts the conversation."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages",
          "next"
        ],
        "title": "MessagePage",
        "description": "Reply to GET /v1/conversations/{id}/messages: a page of messages, oldest first, and the page before it."
      },
      "SendMessage": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Text",
            "description": "What the visitor typed: 1 to 4,000 characters, not only spaces."
          },
          "client_message_id": {
            "$ref": "#/components/schemas/Id",
            "description": "Chosen by the chat. Sending again with the same ID returns the same reply."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "client_message_id"
        ],
        "title": "SendMessage",
        "description": "Body of POST /v1/conversations/{id}/messages. The reply streams StreamEvent lines, with `: ping` heartbeats."
      },
      "Session": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Token"
          },
          "expires_in": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Expires In",
            "description": "Seconds until the token expires."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token",
          "expires_in"
        ],
        "title": "Session",
        "description": "Reply to POST /v1/sessions. The token is opaque to the browser and goes back as `Authorization: Bearer`."
      },
      "SessionRequest": {
        "properties": {
          "widget_id": {
            "$ref": "#/components/schemas/Id"
          },
          "host_token": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8192,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Host Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "widget_id",
          "host_token"
        ],
        "title": "SessionRequest",
        "description": "Body of POST /v1/sessions. A signed-in visitor brings the token the host signed for them; anyone else, null."
      },
      "TextBlock": {
        "properties": {
          "type": {
            "type": "string",
            "const": "text",
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "title": "TextBlock",
        "description": "Plain text, shown exactly as written and never interpreted. Used for what the user typed."
      },
      "UnknownBlock": {
        "properties": {
          "type": {
            "not": {
              "enum": [
                "text",
                "markdown"
              ]
            },
            "type": "string",
            "title": "Type"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "UnknownBlock",
        "description": "A block type this version does not know, sent by a newer gateway. Shown as its `text`, if it has one."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WidgetConfig": {
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "title": "V"
          },
          "widget_id": {
            "$ref": "#/components/schemas/Id"
          },
          "title": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Title"
          },
          "welcome_message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Welcome Message"
          },
          "suggested_prompts": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 4,
            "title": "Suggested Prompts"
          },
          "ai_notice": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Notice",
            "description": "Null means the widget's own wording."
          },
          "brand_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Brand Color"
          },
          "logo_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https://[!-~]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logo Url"
          },
          "color_scheme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "auto"
            ],
            "title": "Color Scheme"
          },
          "launcher_position": {
            "type": "string",
            "enum": [
              "bottom-right",
              "bottom-left"
            ],
            "title": "Launcher Position"
          },
          "history_enabled": {
            "type": "boolean",
            "title": "History Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "v",
          "widget_id",
          "title",
          "welcome_message",
          "suggested_prompts",
          "ai_notice",
          "brand_color",
          "logo_url",
          "color_scheme",
          "launcher_position",
          "history_enabled"
        ],
        "title": "WidgetConfig"
      }
    }
  }
}
